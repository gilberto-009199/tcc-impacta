{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flet Debug (Poetry)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.venv/bin/flet",
            "args": ["run", "${workspaceFolder}/src/main.py", "-d"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}